<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/darkSurface">

    <!-- This is where the user types the name of their gear (e.g. Tent) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Item Name"
        android:textColor="@color/accentGreen"
        android:textSize="14sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/inputItemName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="@string/item_name_hint"
        android:textColor="@color/whiteText"
        android:textColorHint="@color/lightText"
        android:background="@color/cardBackground"
        android:padding="12dp"
        android:textSize="16sp" />

    <!-- This is where the user types the category of the item (e.g. Shelter) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Category"
        android:textColor="@color/accentGreen"
        android:textSize="14sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/inputCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="@string/category_hint"
        android:textColor="@color/whiteText"
        android:textColorHint="@color/lightText"
        android:background="@color/cardBackground"
        android:padding="12dp"
        android:textSize="16sp" />

    <!-- This is where the user types extra notes or quantity for their gear -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quantity / Comment"
        android:textColor="@color/accentGreen"
        android:textSize="14sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/inputComment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/comment_hint"
        android:textColor="@color/whiteText"
        android:textColorHint="@color/lightText"
        android:background="@color/cardBackground"
        android:padding="12dp"
        android:textSize="16sp" />

</LinearLayout>
